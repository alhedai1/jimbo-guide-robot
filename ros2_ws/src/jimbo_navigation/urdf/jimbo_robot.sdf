<?xml version="1.0"?>
<sdf version="1.7">
  <model name="jimbo_robot">
    <pose>0 0 0 0 0 0</pose>

    <!-- Base -->
    <link name="base_link">
      <pose>0 0 0.1135 0 0 0</pose>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.3 0.2 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0.8 1</ambient>
          <diffuse>0 0 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.3 0.2 0.1</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0125</ixx>
          <iyy>0.025</iyy>
          <izz>0.0325</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- Left Wheel -->
    <link name="left_wheel">
      <pose relative_to='base_link'>0 0.12 -0.05 0 0 0</pose>
      <visual name="left_wheel_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0635</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="left_wheel_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0635</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.000025</ixx>
          <iyy>0.000025</iyy>
          <izz>0.000008</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- Right Wheel -->
    <link name="right_wheel">
      <pose relative_to='base_link'>0 -0.12 -0.05 0 0 0</pose>
      <visual name="right_wheel_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0635</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="right_wheel_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0635</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.000025</ixx>
          <iyy>0.000025</iyy>
          <izz>0.000008</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- LiDAR -->
    <link name="robot_lidar_link">
      <pose relative_to='base_link'>0.12 0 0.06 0 0 0</pose>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 1 0.2 1</ambient>
          <diffuse>0.2 1 0.2 1</diffuse>
        </material>
      </visual>

      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-1.57</min_angle>
              <max_angle>1.57</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="ros_gz_lidar" filename="libgz-sim-ros2-sensor-system.so">
          <ros>
            <remapping>scan:=scan</remapping>
            <namespace>/</namespace>
          </ros>
        </plugin>
      </sensor>
    </link>

    <!-- Joints -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>robot_lidar_link</child>
    </joint>

    <static>false</static>
  </model>
</sdf>
